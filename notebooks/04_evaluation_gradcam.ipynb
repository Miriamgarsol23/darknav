   "source": [
    "# DarkNav - Evaluation, Grad-CAM and ONNX Export\n",
    "\n",
    "**Author:** Miriam Garcia Sollo  \n",
    "**Date:** June 2026\n",
    "\n",
    "Days 7-8 of the project plan:\n",
    "\n",
    "1. Load best checkpoints for all three conditions\n",
    "2. Quantitative evaluation on held-out test set (IoU, Precision, Recall, F1)\n",
    "3. Grad-CAM activation maps: where does each model look?\n",
    "4. Qualitative comparison of predictions\n",
    "5. CPU inference benchmark\n",
    "6. ONNX export and onnxruntime benchmark"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "sys.path.insert(0, '..')\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.cm as cm\n",
    "import torch\n",
    "import torch.nn.functional as F\n",
    "import json\n",
    "import time\n",
    "from pathlib import Path\n",
    "from torch.utils.data import DataLoader\n",
    "\n",
    "from src.model import DarkNavUNet\n",
    "from src.synthetic import RealCraterDataset, make_single_crater\n",
    "from src.train import compute_metrics, average_metrics\n",
    "from src.evaluate import evaluate_condition, benchmark_cpu_inference, export_to_onnx\n",
    "\n",
    "plt.rcParams['figure.dpi'] = 120\n",
    "plt.rcParams['axes.grid'] = False\n",
    "plt.rcParams['font.size'] = 10\n",
    "\n",
    "PROC_DIR = Path('../data/processed')\n",
    "RUNS_DIR = Path('../runs')\n",
    "DOCS_DIR = Path('../docs')\n",
    "\n",
    "DEVICE = 'cpu'\n",
    "print('Ready')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load best checkpoints"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_checkpoint(condition: str, mode: str) -> DarkNavUNet:\n",
    "    ckpt_path = RUNS_DIR / condition / f'{condition}_best.pth'\n",
    "    model = DarkNavUNet(mode=mode)\n",
    "    if ckpt_path.exists():\n",
    "        ckpt = torch.load(ckpt_path, map_location='cpu')\n",
    "        model.load_state_dict(ckpt['model_state_dict'])\n",
    "        print(f\"Loaded {condition}: val_IoU={ckpt['val_iou']:.4f}, \"\n",
    "              f\"prec={ckpt['val_precision']:.4f}, rec={ckpt['val_recall']:.4f}\")\n",
    "    else:\n",
    "        print(f\"WARNING: checkpoint not found at {ckpt_path}\")\n",
    "        print(\"         Using untrained model for shape verification.\")\n",
    "    return model.eval()\n",
    "\n",
    "model_A = load_checkpoint('condition_A', 'scratch')\n",
    "model_B = load_checkpoint('condition_B', 'imagenet')\n",
    "model_C = load_checkpoint('condition_C', 'scratch')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Quantitative evaluation on test set"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "test_img_path  = PROC_DIR / 'test_images.npy'\n",
    "test_mask_path = PROC_DIR / 'test_masks.npy'\n",
    "\n",
    "if test_img_path.exists():\n",
    "    test_ds = RealCraterDataset(test_img_path, test_mask_path, augment=False)\n",
    "    test_loader = DataLoader(test_ds, batch_size=8, shuffle=False, num_workers=0)\n",
    "    print(f'Test set: {len(test_ds)} patches')\n",
    "\n",
    "    results = {}\n",
    "    for name, model in [('A_scratch', model_A), ('B_imagenet', model_B), ('C_darknav', model_C)]:\n",
    "        r = evaluate_condition(model, test_loader, name)\n",
    "        results[name] = r\n",
    "else:\n",
    "    print('Test data not found. Run preprocessing pipeline first.')\n",
    "    # Demo results for notebook structure\n",
    "    results = {\n",
    "        'A_scratch':  {'iou': 0.00, 'precision': 0.00, 'recall': 0.00, 'f1': 0.00},\n",
    "        'B_imagenet': {'iou': 0.00, 'precision': 0.00, 'recall': 0.00, 'f1': 0.00},\n",
    "        'C_darknav':  {'iou': 0.00, 'precision': 0.00, 'recall': 0.00, 'f1': 0.00},\n",
    "    }\n",
    "\n",
    "# Print comparison table\n",
    "print()\n",
    "print(f\"{'Condition':<15} {'IoU':>8} {'Precision':>10} {'Recall':>8} {'F1':>8}\")\n",
    "print('-' * 55)\n",
    "for name, r in results.items():\n",
    "    print(f\"{name:<15} {r['iou']:>8.4f} {r['precision']:>10.4f} {r['recall']:>8.4f} {r['f1']:>8.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Grad-CAM implementation\n",
    "\n",
    "Grad-CAM visualises which input regions most strongly activate the output.\n",
    "For a segmentation model, we compute the gradient of the mean output\n",
    "with respect to the last encoder feature map, then weight the channels\n",
    "by their average gradient.\n",
    "\n",
    "Reference: Selvaraju et al. 2017, arXiv:1610.02391"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class GradCAM:\n",
    "    \"\"\"Grad-CAM for U-Net: hooks onto the bottleneck feature map.\"\"\"\n",
    "\n",
    "    def __init__(self, model: DarkNavUNet):\n",
    "        self.model = model\n",
    "        self.gradients = None\n",
    "        self.activations = None\n",
    "        self._register_hooks()\n",
    "\n",
    "    def _register_hooks(self):\n",
    "        # Hook the last encoder block (bottleneck)\n",
    "        target = self.model.encoder.block4 if hasattr(self.model.encoder, 'block4') \\\n",
    "                 else self.model.encoder.block4\n",
    "\n",
    "        def forward_hook(module, input, output):\n",
    "            self.activations = output.detach()\n",
    "\n",
    "        def backward_hook(module, grad_input, grad_output):\n",
    "            self.gradients = grad_output[0].detach()\n",
    "\n",
    "        target.register_forward_hook(forward_hook)\n",
    "        target.register_full_backward_hook(backward_hook)\n",
    "\n",
    "    def compute(self, x: torch.Tensor) -> np.ndarray:\n",
    "        \"\"\"Compute Grad-CAM heatmap for input x.\n",
    "\n",
    "        Returns heatmap normalised to [0, 1], shape (H, W).\n",
    "        \"\"\"\n",
    "        self.model.eval()\n",
    "        x = x.clone().requires_grad_(True)\n",
    "\n",
    "        logits = self.model(x)\n",
    "        score  = logits.mean()  # scalar: mean activation across spatial locations\n",
    "        self.model.zero_grad()\n",
    "        score.backward()\n",
    "\n",
    "        # Weight channels by mean gradient\n",
    "        weights = self.gradients.mean(dim=(2, 3), keepdim=True)  # (1, C, 1, 1)\n",
    "        cam = (weights * self.activations).sum(dim=1, keepdim=True)  # (1, 1, h, w)\n",
    "        cam = F.relu(cam)\n",
    "\n",
    "        # Upsample to input resolution\n",
    "        cam = F.interpolate(cam, size=x.shape[2:], mode='bilinear', align_corners=False)\n",
    "        cam = cam.squeeze().numpy()\n",
    "\n",
    "        if cam.max() > 0:\n",
    "            cam = cam / cam.max()\n",
    "        return cam\n",
    "\n",
    "\n",
    "cam_A = GradCAM(model_A)\n",
    "cam_B = GradCAM(model_B)\n",
    "cam_C = GradCAM(model_C)\n",
    "print('GradCAM hooks registered for all three models.')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Grad-CAM visualisation: the key figure of the project"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Use synthetic craters as test inputs (always available and clean)\n",
    "rng = np.random.default_rng(seed=7)\n",
    "test_patches = []\n",
    "for r_s in [10, 18, 25, 22]:\n",
    "    dem, mask = make_single_crater(size=128, r_s=r_s, noise_std=0.04, rng=rng)\n",
    "    test_patches.append((dem, mask))\n",
    "\n",
    "# If real data is available, replace with real patches\n",
    "if test_img_path.exists():\n",
    "    real_imgs  = np.load(test_img_path,  mmap_mode='r')\n",
    "    real_masks = np.load(test_mask_path, mmap_mode='r')\n",
    "    test_patches = [(real_imgs[i], real_masks[i]) for i in range(4)]\n",
    "    print('Using real test patches for Grad-CAM.')\n",
    "else:\n",
    "    print('Using synthetic patches for Grad-CAM (real data not found).')\n",
    "\n",
    "fig, axes = plt.subplots(5, 4, figsize=(14, 16))\n",
    "row_labels = ['Input DEM', 'Ground truth', 'A: scratch', 'B: imagenet', 'C: DarkNav']\n",
    "\n",
    "for col, (dem, mask) in enumerate(test_patches):\n",
    "    x = torch.from_numpy(dem[np.newaxis, np.newaxis].astype(np.float32))\n",
    "\n",
    "    with torch.no_grad():\n",
    "        pred_A = torch.sigmoid(model_A(x)).squeeze().numpy()\n",
    "        pred_B = torch.sigmoid(model_B(x)).squeeze().numpy()\n",
    "        pred_C = torch.sigmoid(model_C(x)).squeeze().numpy()\n",
    "\n",
    "    heatmap_A = cam_A.compute(x)\n",
    "    heatmap_B = cam_B.compute(x)\n",
    "    heatmap_C = cam_C.compute(x)\n",
    "\n",
    "    rows_data = [\n",
    "        (dem,        'gray',     -1,   1,   None),\n",
    "        (mask,       'binary_r',  0,   1,   None),\n",
    "        (heatmap_A,  'jet',       0,   1,   pred_A),\n",
    "        (heatmap_B,  'jet',       0,   1,   pred_B),\n",
    "        (heatmap_C,  'jet',       0,   1,   pred_C),\n",
    "    ]\n",
    "\n",
    "    for row, (img, cmap, vmin, vmax, pred) in enumerate(rows_data):\n",
    "        axes[row, col].imshow(img, cmap=cmap, vmin=vmin, vmax=vmax)\n",
    "        if pred is not None:\n",
    "            axes[row, col].contour(pred > 0.5, colors='white', linewidths=0.8)\n",
    "        axes[row, col].axis('off')\n",
    "        if col == 0:\n",
    "            axes[row, col].set_ylabel(row_labels[row], fontsize=9)\n",
    "\n",
    "plt.suptitle('Grad-CAM: model attention maps (heatmap) with prediction contours (white)',\n",
    "             fontsize=11)\n",
    "plt.tight_layout()\n",
    "plt.savefig(DOCS_DIR / 'fig21_gradcam.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print('Saved: fig21_gradcam.png')\n",
    "print()\n",
    "print('Interpretation:')\n",
    "print('  A (scratch): attention may be scattered or focused on texture, not rim.')\n",
    "print('  B (imagenet): attention guided by ImageNet edge features.')\n",
    "print('  C (DarkNav): attention should be concentrated on the circular rim,')\n",
    "print('               because NFW pretraining taught the model radial symmetry.')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. CPU inference benchmark"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('Benchmarking CPU inference (50 runs per model)...')\n",
    "print()\n",
    "\n",
    "timings = {}\n",
    "for name, model in [('A_scratch', model_A), ('B_imagenet', model_B), ('C_darknav', model_C)]:\n",
    "    t = benchmark_cpu_inference(model, n_runs=50)\n",
    "    timings[name] = t\n",
    "    status = 'PASS' if t['passes'] else 'FAIL'\n",
    "    print(f\"  {name:<15}: {t['mean_ms']:6.1f} +/- {t['std_ms']:.1f} ms  [{status} target 100ms]\")\n",
    "\n",
    "# Bar chart\n",
    "fig, ax = plt.subplots(figsize=(7, 4))\n",
    "names  = list(timings.keys())\n",
    "means  = [timings[n]['mean_ms'] for n in names]\n",
    "stds   = [timings[n]['std_ms']  for n in names]\n",
    "colors = ['steelblue', 'coral', 'teal']\n",
    "\n",
    "bars = ax.bar(names, means, yerr=stds, capsize=5, color=colors, alpha=0.85)\n",
    "ax.axhline(100, color='red', ls='--', lw=1.5, label='100ms target (on-orbit)')\n",
    "ax.set_ylabel('Inference time (ms)')\n",
    "ax.set_title('CPU inference time per 128x128 patch')\n",
    "ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig(DOCS_DIR / 'fig22_inference_time.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print('Saved: fig22_inference_time.png')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. ONNX export and onnxruntime benchmark"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from src.evaluate import export_to_onnx, benchmark_onnx\n",
    "\n",
    "for name, model in [('condition_A', model_A), ('condition_B', model_B), ('condition_C', model_C)]:\n",
    "    onnx_path = RUNS_DIR / name / f'{name}.onnx'\n",
    "    (RUNS_DIR / name).mkdir(parents=True, exist_ok=True)\n",
    "    export_to_onnx(model, onnx_path)\n",
    "    t = benchmark_onnx(onnx_path)\n",
    "    if t:\n",
    "        print(f\"  {name} ONNX: {t['mean_ms']:.1f} ms\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Final results summary figure"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "\n",
    "# Load training history for context\n",
    "def load_history(path):\n",
    "    if Path(path).exists():\n",
    "        with open(path) as f:\n",
    "            return json.load(f)\n",
    "    return {}\n",
    "\n",
    "h_A    = load_history(RUNS_DIR / 'condition_A' / 'condition_A_history.json')\n",
    "h_B    = load_history(RUNS_DIR / 'condition_B' / 'condition_B_history.json')\n",
    "h_C    = load_history(RUNS_DIR / 'condition_C' / 'condition_C_history.json')\n",
    "h_Cpre = load_history(RUNS_DIR / 'condition_C' / 'nfw_pretrain_history.json')\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 5))\n",
    "\n",
    "# Left: training curves\n",
    "ax = axes[0]\n",
    "if h_A.get('val_iou'):  ax.plot(h_A['val_iou'],    label='A: scratch',        color='steelblue', lw=2)\n",
    "if h_B.get('val_iou'):  ax.plot(h_B['val_iou'],    label='B: imagenet',       color='coral',     lw=2)\n",
    "if h_C.get('val_iou'):  ax.plot(h_C['val_iou'],    label='C: DarkNav',        color='teal',      lw=2)\n",
    "if h_Cpre.get('val_iou'): ax.plot(h_Cpre['val_iou'], label='C: NFW pretrain', color='teal', lw=1.2, ls='--', alpha=0.6)\n",
    "ax.set_xlabel('Epoch')\n",
    "ax.set_ylabel('Validation IoU')\n",
    "ax.set_title('Training curves')\n",
    "ax.legend(fontsize=9)\n",
    "\n",
    "# Right: test set bar chart\n",
    "ax = axes[1]\n",
    "metrics = ['iou', 'precision', 'recall', 'f1']\n",
    "x = np.arange(len(metrics))\n",
    "width = 0.25\n",
    "conds = [('A_scratch', 'steelblue', results), ('B_imagenet', 'coral', results), ('C_darknav', 'teal', results)]\n",
    "for i, (name, color, res) in enumerate(conds):\n",
    "    if name in res:\n",
    "        vals = [res[name][m] for m in metrics]\n",
    "        ax.bar(x + i*width, vals, width, label=name, color=color, alpha=0.85)\n",
    "ax.set_xticks(x + width)\n",
    "ax.set_xticklabels(['IoU', 'Precision', 'Recall', 'F1'])\n",
    "ax.set_ylabel('Score')\n",
    "ax.set_ylim(0, 1.05)\n",
    "ax.set_title('Test set metrics comparison')\n",
    "ax.legend(fontsize=9)\n",
    "\n",
    "plt.suptitle('DarkNav: complete results', fontsize=12)\n",
    "plt.tight_layout()\n",
    "plt.savefig(DOCS_DIR / 'fig23_final_results.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print('Saved: fig23_final_results.png')"
   ]
  }
