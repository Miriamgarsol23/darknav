   "source": [
    "# Load pos_weight computed in Day 3\n",
    "pos_weight_path = DATA_DIR / 'pos_weight.npy'\n",
    "if pos_weight_path.exists():\n",
    "    pos_weight = float(np.load(pos_weight_path)[0])\n",
    "else:\n",
