  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Visualise encoder feature maps\n",
    "\n",
    "Pass a real DEM patch through the encoder and visualise what each\n",
    "stage has learned to detect. This is useful for understanding whether\n",
    "the NFW pretraining changes the feature representations."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from src.synthetic import make_single_crater\n",
    "\n",
    "# Use a synthetic crater as test input (always available)\n",
    "dem, _ = make_single_crater(size=128, r_s=20, noise_std=0.03,\n",
    "                             rng=np.random.default_rng(42))\n",
    "x = torch.from_numpy(dem[np.newaxis, np.newaxis])  # (1, 1, 128, 128)\n",
    "\n",
    "# Also try a real patch if available\n",
    "real_path = PROC_DIR / 'train_images.npy'\n",
    "if real_path.exists():\n",
    "    real_images = np.load(real_path, mmap_mode='r')\n",
    "    x_real = torch.from_numpy(real_images[5][np.newaxis, np.newaxis])\n",
    "    print('Using real DEM patch as second input.')\n",
    "else:\n",
    "    x_real = None\n",
    "    print('Real data not available. Using synthetic only.')\n",
    "\n",
    "model_A = DarkNavUNet(mode='scratch').eval()\n",
    "\n",
    "with torch.no_grad():\n",
    "    s0, s1, s2, s3, s4 = model_A.encoder(x)\n",
    "\n",
    "print('Encoder feature map shapes:')\n",
    "for name, feat in [('s0 (stem)', s0), ('s1 (block1)', s1),\n",
    "                   ('s2 (block2)', s2), ('s3 (block3)', s3),\n",
    "                   ('s4 (bottleneck)', s4)]:\n",
    "    print(f'  {name}: {tuple(feat.shape)}')\n",
    "\n",
    "# Visualise first 8 channels of each stage\n",
    "fig, axes = plt.subplots(5, 9, figsize=(18, 11))\n",
    "stages = [('s0 stem (32ch)', s0), ('s1 block1 (64ch)', s1),\n",
    "          ('s2 block2 (128ch)', s2), ('s3 block3 (256ch)', s3),\n",
    "          ('s4 bottleneck (512ch)', s4)]\n",
    "\n",
    "for row, (label, feat) in enumerate(stages):\n",
    "    # First column: input or upsampled version\n",
    "    axes[row, 0].imshow(dem, cmap='gray', vmin=-1, vmax=1)\n",
    "    axes[row, 0].set_title('Input DEM', fontsize=7)\n",
    "    axes[row, 0].axis('off')\n",
    "    axes[row, 0].set_ylabel(label, fontsize=7)\n",
    "\n",
    "    # Next 8 columns: feature channels\n",
    "    for ch in range(8):\n",
    "        f = feat[0, ch].numpy()\n",
    "        axes[row, ch+1].imshow(f, cmap='RdBu_r',\n",
    "                                vmin=-np.abs(f).max(), vmax=np.abs(f).max())\n",
    "        axes[row, ch+1].set_title(f'ch{ch}', fontsize=7)\n",
    "        axes[row, ch+1].axis('off')\n",
    "\n",
    "plt.suptitle('Encoder feature maps (scratch mode, synthetic input)', fontsize=10)\n",
    "plt.tight_layout()\n",
    "plt.savefig(DOCS_DIR / 'fig18_feature_maps.png', dpi=120, bbox_inches='tight')\n",
    "plt.show()\n",
    "print('Saved: fig18_feature_maps.png')"
   ]
  },
