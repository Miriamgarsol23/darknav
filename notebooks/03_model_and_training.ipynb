    "    )\n",
    "    REAL_DATA_AVAILABLE = True\n",
    "    print('Real data available.')\n",
    "else:\n",
    "    # Fallback: use synthetic for train and val (results will not be meaningful,\n",
    "    # but the training loop and code are verified to work)\n",
    "    synth_val = SyntheticCraterDataset(n_samples=100, seed=99, augment=False)\n",
    "    train_loader = synth_loader\n",
    "    val_loader   = DataLoader(synth_val, batch_size=8, shuffle=False, num_workers=0)\n",
    "    test_loader  = val_loader\n",
    "    REAL_DATA_AVAILABLE = False\n",
    "    print('Real data not found. Running in synthetic-only demo mode.')\n",
    "    print('Training curves will show synthetic->synthetic performance only.')"
