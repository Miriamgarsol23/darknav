   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Snapshot predictions after training"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load best checkpoints\n",
    "def load_best_model(condition: str, mode: str) -> DarkNavUNet:\n",
    "    ckpt_path = RUNS_DIR / condition / f'{condition}_best.pth'\n",
    "    m = DarkNavUNet(mode=mode)\n",
    "    if ckpt_path.exists():\n",
    "        ckpt = torch.load(ckpt_path, map_location='cpu')\n",
    "        m.load_state_dict(ckpt['model_state_dict'])\n",
    "        print(f'Loaded {condition}: val_IoU={ckpt[\"val_iou\"]:.4f}')\n",
    "    else:\n",
    "        print(f'Checkpoint not found for {condition}, using current weights.')\n",
    "    return m.eval()\n",
    "\n",
    "best_A  = load_best_model('condition_A', 'scratch')\n",
    "best_B  = load_best_model('condition_B', 'imagenet')\n",
    "\n",
    "# Load condition C finetune checkpoint\n",
    "ckpt_C = RUNS_DIR / 'condition_C' / 'condition_C_best.pth'\n",
    "best_C = DarkNavUNet(mode='scratch')\n",
    "if ckpt_C.exists():\n",
    "    ckpt = torch.load(ckpt_C, map_location='cpu')\n",
    "    best_C.load_state_dict(ckpt['model_state_dict'])\n",
    "    print(f'Loaded condition_C: val_IoU={ckpt[\"val_iou\"]:.4f}')\n",
    "best_C = best_C.eval()\n",
    "\n",
    "# Get a few test patches\n",
    "test_iter = iter(test_loader)\n",
    "test_imgs, test_masks = next(test_iter)\n",
    "\n",
    "n_show = min(4, len(test_imgs))\n",
    "fig, axes = plt.subplots(4, n_show, figsize=(3*n_show, 11))\n",
    "\n",
    "row_labels = ['Input DEM', 'Ground truth', 'A: scratch', 'B: imagenet']\n",
    "\n",
    "with torch.no_grad():\n",
    "    pred_A = torch.sigmoid(best_A(test_imgs)).numpy()\n",
    "    pred_B = torch.sigmoid(best_B(test_imgs)).numpy()\n",
    "\n",
    "for col in range(n_show):\n",
    "    axes[0, col].imshow(test_imgs[col, 0].numpy(), cmap='gray', vmin=-1, vmax=1)\n",
    "    axes[1, col].imshow(test_masks[col, 0].numpy(), cmap='binary_r')\n",
    "    axes[2, col].imshow(pred_A[col, 0], cmap='binary_r', vmin=0, vmax=1)\n",
    "    axes[3, col].imshow(pred_B[col, 0], cmap='binary_r', vmin=0, vmax=1)\n",
    "    for row in range(4):\n",
    "        axes[row, col].axis('off')\n",
    "        if col == 0:\n",
    "            axes[row, col].set_ylabel(row_labels[row], fontsize=8)\n",
    "\n",
    "plt.suptitle(f'Predictions after {EPOCHS_DEMO} epochs (demo run)', fontsize=10)\n",
