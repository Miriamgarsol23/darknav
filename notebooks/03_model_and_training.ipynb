   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Test forward pass with loss computation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from src.synthetic import make_single_crater\n",
    "\n",
    "# Build a small batch\n",
    "rng = np.random.default_rng(0)\n",
    "batch_imgs, batch_masks = [], []\n",
    "for _ in range(4):\n",
    "    d, m = make_single_crater(r_s=rng.uniform(10, 25), noise_std=0.04, rng=rng)\n",
    "    batch_imgs.append(d[np.newaxis])\n",
    "    batch_masks.append(m[np.newaxis].astype(np.float32))\n",
    "\n",
    "images = torch.from_numpy(np.stack(batch_imgs))   # (4, 1, 128, 128)\n",
    "masks  = torch.from_numpy(np.stack(batch_masks))  # (4, 1, 128, 128)\n",
    "\n",
    "model_test = DarkNavUNet(mode='scratch')\n",
    "pos_weight_val = 9.0\n",
    "criterion = torch.nn.BCEWithLogitsLoss(\n",
    "    pos_weight=torch.tensor([pos_weight_val])\n",
    ")\n",
    "\n",
    "logits = model_test(images)\n",
    "loss   = criterion(logits, masks)\n",
    "metrics = compute_metrics(logits.detach(), masks)\n",
    "\n",
    "print('Forward pass test:')\n",
    "print(f'  Input shape  : {tuple(images.shape)}')\n",
    "print(f'  Output shape : {tuple(logits.shape)}')\n",
    "print(f'  Loss (random init): {loss.item():.4f}')\n",
    "print(f'  IoU  (random init): {metrics[\"iou\"]:.4f}  (expect near 0 before training)')\n",
    "print(f'  Prec (random init): {metrics[\"precision\"]:.4f}')\n",
    "print(f'  Recall (random init): {metrics[\"recall\"]:.4f}')\n",
    "\n",
    "# Test backward pass\n",
    "loss.backward()\n",
    "grad_norm = sum(p.grad.norm().item() for p in model_test.parameters() if p.grad is not None)\n",
    "print(f'  Gradient norm: {grad_norm:.4f}  (non-zero means backprop works)')\n",
    "print('Forward + backward pass: OK')"
   ]
  },
